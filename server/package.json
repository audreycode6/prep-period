{
  "name": "@prep-period/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "knex": "tsx --env-file-if-exists=../.env ../node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "migrate": "npm run knex -- migrate:latest",
    "migrate:make": "npm run knex -- migrate:make",
    "rollback": "npm run knex -- migrate:rollback",
    "seed": "tsx --env-file-if-exists=../.env src/seed.ts"
  },
  "dependencies": {
    "@prep-period/shared": "^0.0.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
